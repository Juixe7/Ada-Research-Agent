# ==============================================================================
# ADA DEEP RESEARCH — ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- AI & Search Provider API Keys ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# --- Database & Authentication ---
# Local dev default: sqlite:///./ada.db
# Production (Neon Serverless PostgreSQL): postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./ada.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes

# --- Distributed Queue & Vector Store ---
# Local dev: leave USE_CELERY=false and QDRANT_URL empty (uses local disk ./qdrant_data and BackgroundTasks)
# Production Docker Compose: automatically set to USE_CELERY=true, REDIS_URL=redis://redis:6379/0, QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=
QDRANT_API_KEY=
USE_CELERY=false

# --- Optional local AI observability (Langfuse; off unless explicitly enabled) ---
# Run Langfuse locally, create a project, then copy its keys into your ignored .env.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# For local Python (outside Docker): http://localhost:3000
# For Ada containers on Docker Desktop: http://host.docker.internal:3000
LANGFUSE_OTEL_HOST=http://localhost:3000

# --- Domain Name for Caddy Automatic HTTPS (Production) ---
# Example: ada.yourdomain.com (or leave as :80 for raw EC2 IP address)
DOMAIN_NAME=:80

# --- Password reset email (required to deliver reset links) ---
PUBLIC_APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
